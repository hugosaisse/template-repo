{
  "name": "Kestrel Support API",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "GitHub.copilot", "GitHub.copilot-chat"]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && (npx -y @database-mcp/sqlite@0.4.2 --help >/dev/null 2>&1 || true)",
  "forwardPorts": [8000]
}
